description <https://fireforce6.github.io/mission-control/system-analysis/connections#> as connections {

	extends <https://fireforce6.github.io/mission-control/system-analysis/components#> as components

	uses <https://www.modelware.io/sierra/component#> as component

	uses <http://purl.org/dc/elements/1.1/> as dc

    ref instance components:FireSat [
        component:hasPort FireSat.Command_In
        component:hasPort FireSat.Telemetry_Out
    ]
    instance FireSat.Command_In : component:Port [ component:direction "In" ]
    instance FireSat.Telemetry_Out : component:Port [ component:direction "Out" ]

    ref instance components:Payload [
        component:hasPort Payload.Data_Out
        component:hasPort Payload.Power_In
    ]
    instance Payload.Data_Out : component:Port [ component:direction "Out" ]
    instance Payload.Power_In : component:Port [ component:direction "In" ]

    ref instance components:Platform [
        component:hasPort Platform.Data_In
        component:hasPort Platform.Data_Out
        component:hasPort Platform.Power_Out
        component:hasPort Platform.Command_In
    ]
    instance Platform.Data_In : component:Port [ component:direction "In" ]
    instance Platform.Data_Out : component:Port [ component:direction "Out" ]
    instance Platform.Power_Out : component:Port [ component:direction "Out" ]
    instance Platform.Command_In : component:Port [ component:direction "In" ]

    ref instance components:PropulsionSegment [
        component:hasPort Propulsion.Command_In
        component:hasPort Propulsion.Power_In
    ]
    instance Propulsion.Command_In : component:Port [ component:direction "In" ]
    instance Propulsion.Power_In : component:Port [ component:direction "In" ]

    @dc:description "The Launch Vehicle has several ports for power, command, and telemetry signals."
    ref instance components:LaunchVehicle [
        component:hasPort LaunchVehicle.Power_In
        component:hasPort LaunchVehicle.Command_In
        component:hasPort LaunchVehicle.Telemetry_Out
        component:hasPort LaunchVehicle.Command_Out
        component:hasPort LaunchVehicle.Power_Out
    ]
    @dc:description "Port Descriptions for Launch Vehicle"
    instance LaunchVehicle.Power_In : component:Port [ component:direction "In" ]
    instance LaunchVehicle.Command_In : component:Port [ component:direction "In" ]
    instance LaunchVehicle.Telemetry_Out : component:Port [ component:direction "Out" ]
    instance LaunchVehicle.Command_Out : component:Port [ component:direction "Out" ]
    instance LaunchVehicle.Power_Out : component:Port [ component:direction "Out" ]

    @dc:description "The Boosters have ports for power and command"
    ref instance components:Booster [
        component:hasPort Booster.Power_In
        component:hasPort Booster.Command_In
    ]
    @dc:description "Port Descriptions for Booster"
    instance Booster.Power_In : component:Port [ component:direction "In" ]
    instance Booster.Command_In : component:Port [ component:direction "In" ]
    @dc:description "Command Connection from Launch Vehicle to Booster"
    relation instance Conn_LaunchVehicle_to_Booster : component:Connection [
        from LaunchVehicle.Command_Out
        to Booster.Command_In
        component:transfers CommandSignal
    ]
    @dc:description "Power Connection from Launch Vehicle to Booster"
    relation instance Power_LaunchVehicle_to_Booster : component:Connection [
        from LaunchVehicle.Power_Out
        to Booster.Power_In
        component:transfers ElectricalPower
    ]

    instance TelemetrySignal : component:Signal []
    instance CommandSignal : component:Signal []
    instance ElectricalPower : component:Energy []

    relation instance Conn_FireSatCmd_to_Platform : component:Connection [
        from FireSat.Command_In
        to Platform.Command_In
        component:transfers CommandSignal
    ]

    relation instance Conn_PlatformPower_to_Payload : component:Connection [
        from Platform.Power_Out
        to Payload.Power_In
        component:transfers ElectricalPower
    ]

    relation instance Conn_PlatformPower_to_Propulsion : component:Connection [
        from Platform.Power_Out
        to Propulsion.Power_In
        component:transfers ElectricalPower
    ]

    relation instance Conn_Payload_to_Platform : component:Connection [
        from Payload.Data_Out
        to Platform.Data_In
        component:transfers TelemetrySignal
    ]

    relation instance Conn_Platform_to_FireSatTelem : component:Connection [
        from Platform.Data_Out
        to FireSat.Telemetry_Out
        component:transfers TelemetrySignal
    ]

    // ==========================================
    // Three new real valid connection instances
    // ==========================================

    @dc:description "Backup power line from Platform to Launch Vehicle during pre-launch checks."
    relation instance Conn_PlatformPower_to_LaunchVehicle : component:Connection [
        from Platform.Power_Out
        to LaunchVehicle.Power_In
        component:transfers ElectricalPower
    ]

    @dc:description "Booster telemetry stream forwarded from Launch Vehicle into Platform data interface."
    relation instance Conn_LaunchVehicleTelem_to_Platform : component:Connection [
        from LaunchVehicle.Telemetry_Out
        to Platform.Data_In
        component:transfers TelemetrySignal
    ]

    @dc:description "Launch staging coordination commands sent from Platform to Launch Vehicle."
    relation instance Conn_Platform_to_LaunchVehicleCmd : component:Connection [
        from Platform.Data_Out
        to LaunchVehicle.Command_In
        component:transfers CommandSignal
    ]

    // ==========================================
    // One intentional rule violation (Invalid)
    // ==========================================

    // @dc:description "INVALID: This connection connects an In port to an Out port on purpose."
    //relation instance Conn_Invalid_Payload_to_Platform : component:Connection [
    //   from Payload.Power_In
    //    to Platform.Power_Out
    //    component:transfers ElectricalPower
    //]

}
